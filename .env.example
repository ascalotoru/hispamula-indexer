# Copy to .env and fill in. HISPAMULA_USER is your hispamula.org
# handle (login name), NOT your registration email — the email logs
# in as anonymous.
HISPAMULA_USER=your_hispamula_handle
HISPAMULA_PASSWORD=your_password

# Optional overrides (defaults shown).
# HISPAMULA_BASE_URL=https://www.hispamula.org
# HISPAMULA_REQUEST_DELAY=1.0
# HISPAMULA_CACHE_TTL=600
# HISPAMULA_TIMEOUT=30.0
# HISPAMULA_MAX_RESULTS=25
# HISPAMULA_USER_AGENT=hispamula-indexer/0.1
